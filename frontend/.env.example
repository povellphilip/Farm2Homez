# Farm2Home frontend configuration (Vite). Copy to .env.local for local overrides.
# Only VITE_* variables reach the browser; never put secrets here.

# Public site address, used for canonical links, social previews, structured data and the
# sitemap line in robots.txt. Leave empty in development.
VITE_SITE_URL=

# Development only: where the Vite dev server proxies /api and /media (defaults to Django on :8000).
VITE_DEV_API_TARGET=http://127.0.0.1:8000
