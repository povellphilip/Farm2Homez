# ============================================================================
# FARM2HOMEZ ENVIRONMENT CONFIGURATION
# ============================================================================
# Copy this file to .env and fill in your actual values
# NEVER commit .env to version control
# ============================================================================

# ============================================================================
# ENVIRONMENT & DEBUG
# ============================================================================
ENVIRONMENT=production
DEBUG=False
LOG_LEVEL=INFO
DJANGO_LOG_LEVEL=INFO

# ============================================================================
# SECURITY & SECRETS
# ============================================================================
# Generate a strong SECRET_KEY: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=your-secret-key-here-change-this-in-production

# Generate JWT secret: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET=your-jwt-secret-here-change-this-in-production

# ============================================================================
# HOSTS & URLS
# ============================================================================
# For development: localhost,127.0.0.1
# For production on Railway: .railway.app,.up.railway.app
ALLOWED_HOSTS=localhost,127.0.0.1,.railway.app

# Frontend URL - will be your Vercel domain in production
FRONTEND_URL=http://localhost:5173

# Backend URL - will be your Railway domain in production
BACKEND_URL=http://127.0.0.1:8000

# ============================================================================
# DATABASE
# ============================================================================
# Development: sqlite:///db.sqlite3
# Production PostgreSQL on Neon: postgresql://user:password@host/database
DATABASE_URL=sqlite:///db.sqlite3

# ============================================================================
# CORS & CSRF
# ============================================================================
# Comma-separated list of allowed origins for local development
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Comma-separated list for CSRF trusted origins (same as CORS_ALLOWED_ORIGINS for development)
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ============================================================================
# SECURITY - HTTPS & REDIRECTS
# ============================================================================
# Set to True in production when using HTTPS
SECURE_SSL_REDIRECT=False

# ============================================================================
# CACHE & SESSIONS (Redis)
# ============================================================================
# Development: redis://localhost:6379/0
# Production: redis://:password@host:port/0 (from Railway)
REDIS_URL=redis://localhost:6379/0

# Celery broker URL
CELERY_BROKER_URL=redis://localhost:6379/1

# Celery result backend URL
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# ============================================================================
# EMAIL CONFIGURATION
# ============================================================================
# Gmail SMTP (for development)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password-here
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=no-reply@farm2homez.com
ADMIN_NOTIFICATION_EMAIL=admin@farm2homez.com

# Email Provider (smtp, sendgrid, brevo)
EMAIL_PROVIDER=smtp

# SendGrid API Key (if using SendGrid)
SENDGRID_API_KEY=

# Brevo API Key (if using Brevo)
BREVO_API_KEY=

# ============================================================================
# CLOUDINARY IMAGE STORAGE
# ============================================================================
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# ============================================================================
# TWILIO WHATSAPP (Optional)
# ============================================================================
WHATSAPP_PROVIDER=twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# ============================================================================
# GUNICORN CONFIGURATION
# ============================================================================
PORT=8000
WEB_CONCURRENCY=2
GUNICORN_THREADS=2
GUNICORN_TIMEOUT=120
